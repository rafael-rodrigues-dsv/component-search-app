a # ========================================
# SCRAPER INTELLIGENT SYSTEM - FEATURE FLAGS
# ========================================
#
# Este arquivo define as feature flags para controle
# do sistema de scraping inteligente (V2)
#
# IMPORTANTE: Copie para .env e ajuste conforme necessário
#

# ========================================
# FLAG PRINCIPAL
# ========================================

# Habilita o sistema inteligente de scraping
# true = usa novo scraper (com chaveamento)
# false = usa apenas scraper legado
USE_INTELLIGENT_SCRAPER=false

# ========================================
# FLAGS POR ENGINE DE BUSCA
# ========================================

# Força uso do Google Scraper V2 (ignora rollout)
# true = sempre usa GoogleScraperV2
# false = respeita USE_INTELLIGENT_SCRAPER e ROLLOUT_PERCENTAGE
GOOGLE_USE_NEW_SCRAPER=false

# Força uso do DuckDuckGo Scraper V2 (ignora rollout)
# true = sempre usa DuckDuckGoScraperV2
# false = respeita USE_INTELLIGENT_SCRAPER e ROLLOUT_PERCENTAGE
DUCKDUCKGO_USE_NEW_SCRAPER=false

# ========================================
# ROLLOUT GRADUAL (A/B TESTING)
# ========================================

# Porcentagem de tráfego que usa o novo scraper
# 0 = ninguém usa novo (apenas legado)
# 10 = 10% usa novo, 90% usa legado
# 50 = 50% usa novo, 50% usa legado
# 100 = todos usam novo
#
# Valores: 0-100
ROLLOUT_PERCENTAGE=0

# ========================================
# FALLBACK AUTOMÁTICO
# ========================================

# Se novo scraper falhar, usar legado automaticamente?
# true = fallback automático (recomendado para produção)
# false = não usar fallback (apenas para testes)
FALLBACK_TO_LEGACY_ON_ERROR=true

# Timeout para novo scraper antes de fazer fallback
# Se novo scraper exceder este tempo, usa legado
# Valor em segundos
NEW_SCRAPER_TIMEOUT_SECONDS=10

# ========================================
# MODO COMPARAÇÃO (VALIDAÇÃO)
# ========================================

# Executa AMBOS scrapers (novo e legado) e compara resultados
# true = executa ambos (útil para validação antes de rollout)
# false = executa apenas um (normal)
#
# ATENÇÃO: Dobra o tempo de execução! Usar apenas em testes.
COMPARISON_MODE=false

# ========================================
# LOGGING
# ========================================

# Habilita logging detalhado (verboso)
# true = logs completos de todas fases
# false = logs resumidos
VERBOSE_LOGGING=true

# ========================================
# EXEMPLOS DE CONFIGURAÇÃO POR AMBIENTE
# ========================================

# --- DESENVOLVIMENTO ---
# USE_INTELLIGENT_SCRAPER=false
# COMPARISON_MODE=false
# Resultado: Usa apenas legado

# --- VALIDAÇÃO (Modo Comparação) ---
# USE_INTELLIGENT_SCRAPER=false
# COMPARISON_MODE=true
# Resultado: Executa ambos e compara

# --- CANARY (Rollout 10%) ---
# USE_INTELLIGENT_SCRAPER=true
# ROLLOUT_PERCENTAGE=10
# FALLBACK_TO_LEGACY_ON_ERROR=true
# Resultado: 10% usa novo com fallback

# --- STAGING (Rollout 50%) ---
# USE_INTELLIGENT_SCRAPER=true
# ROLLOUT_PERCENTAGE=50
# FALLBACK_TO_LEGACY_ON_ERROR=true
# Resultado: 50% usa novo com fallback

# --- PRODUÇÃO (Rollout 100%) ---
# USE_INTELLIGENT_SCRAPER=true
# ROLLOUT_PERCENTAGE=100
# FALLBACK_TO_LEGACY_ON_ERROR=true
# Resultado: Todos usam novo com fallback

# --- PRODUÇÃO ESTÁVEL ---
# GOOGLE_USE_NEW_SCRAPER=true
# DUCKDUCKGO_USE_NEW_SCRAPER=true
# FALLBACK_TO_LEGACY_ON_ERROR=false
# Resultado: Apenas novo, sem fallback

# ========================================
# NOTAS IMPORTANTES
# ========================================
#
# 1. ROLLBACK INSTANTÂNEO:
#    Para voltar ao legado, basta mudar:
#    USE_INTELLIGENT_SCRAPER=false
#    e reiniciar o sistema (< 1 minuto)
#
# 2. PRIORIDADE DE FLAGS:
#    GOOGLE_USE_NEW_SCRAPER > USE_INTELLIGENT_SCRAPER > ROLLOUT_PERCENTAGE
#
# 3. FALLBACK É AUTOMÁTICO:
#    Se novo scraper falhar e FALLBACK_TO_LEGACY_ON_ERROR=true,
#    o sistema usa legado automaticamente (zero downtime)
#
# 4. MODO COMPARAÇÃO DOBRA TEMPO:
#    Use apenas para validação antes de rollout.
#    NÃO usar em produção!
#
# 5. LOGS VERBOSOS EM PRODUÇÃO:
#    Considere VERBOSE_LOGGING=false em produção
#    para reduzir volume de logs.
#
